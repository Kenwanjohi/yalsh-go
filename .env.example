# --- Docker Hub ---
# Your Docker Hub username
DOCKER_USERNAME=your_username

# --- Database ---
# Replace with your actual Neon DSN (ensure you include sslmode=verify-full)
PG_CONN=postgres://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# --- Security ---
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key

# --- Domain & Networking ---
# Your production domain or 'localhost' for local testing
DOMAIN_NAME=localhost
